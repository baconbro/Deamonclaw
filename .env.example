# Copy this file to .env and fill in your values.
# docker-compose.yml reads from .env automatically.

# ── Required ────────────────────────────────────────────────────────────────

# Your Anthropic API key (used by daemon sidecar for embeddings / routing)
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional overrides ───────────────────────────────────────────────────────

# WebSocket URL of your OpenClaw gateway
# Default: ws://host.docker.internal:18789  (Docker → host)
# If running without Docker: ws://localhost:18789
OPENCLAW_GATEWAY_URL=ws://host.docker.internal:18789

# PostgreSQL connection string (only needed if using an external database)
# Default: docker-compose service (daemon-db)
# DATABASE_URL=postgresql://daemon:daemon@localhost:5433/daemon

# REST API port for the sidecar
# Default: 8400
# API_PORT=8400
